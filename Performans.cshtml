@model Entity.Stajyer
@{
    ViewData["Title"] = "Performans Raporu";
    var haftalikPerformans = ViewBag.HaftalikPerformans as List<Entity.PerformansSkoru> ?? new List<Entity.PerformansSkoru>();
    var sonPerformans = ViewBag.SonPerformans as Entity.PerformansSkoru;
}
<style>
    .performans-page .card-body .btn-primary {
        background-color: #2a5298;
        border-color: #2a5298;
        color: #fff;
    }
    .performans-page .card-body .btn-primary:hover {
        background-color: #1a3a6e;
        border-color: #1a3a6e;
        color: #fff;
    }
</style>
<div class="container performans-page">
    <h2 class="mb-4">Performans Raporu</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @{
        var stajBitti = Model.BitisTarihi != default(DateTime) && Model.BitisTarihi.Year >= 2000 && DateTime.Now >= Model.BitisTarihi;
    }
    
    @if (stajBitti && sonPerformans != null && sonPerformans.SorumluFinalPuanı.HasValue)
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h5>Final Performans Skoru: @sonPerformans.SorumluFinalPuanı.Value.ToString("F2") / 100</h5>
                        <small class="text-muted">Sorumlu Değerlendirmesi</small>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h6>Günlük Giriş Düzeni</h6>
                                    <h3 class="text-primary">@sonPerformans.GunlukGirisDuzeni.ToString("F1")%</h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h6>Görev Tamamlama</h6>
                                    <h3 class="text-success">@sonPerformans.GorevTamamlamaOrani.ToString("F1")%</h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h6>Sorumlu Değerlendirmesi</h6>
                                    <h3 class="text-info">@sonPerformans.SorumluDegerlendirmesi.ToString("F1")</h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h6>Zamanında Teslim</h6>
                                    <h3 class="text-warning">@sonPerformans.GecTeslimOrani.ToString("F1")%</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (!stajBitti)
    {
        <div class="alert alert-info">
            <h5>Performans Skoru: 0</h5>
            <p>Staj devam ediyor. Performans skoru staj bitince sorumlu tarafından değerlendirilecektir.</p>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <h5>Performans Skoru: 0</h5>
            <p>Staj bitmiş ancak henüz sorumlu tarafından değerlendirilmemiş.</p>
        </div>
    }

    @if (haftalikPerformans.Any())
    {
        <div class="card">
            <div class="card-header">
                <h5>Haftalık Performans Trendi</h5>
            </div>
            <div class="card-body">
                <canvas id="performansChart" width="400" height="100"></canvas>
            </div>
        </div>

        <div class="mt-4">
            <h5>Haftalık Detaylar</h5>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Hafta</th>
                        <th>Toplam Skor</th>
                        <th>Giriş Düzeni</th>
                        <th>Görev Tamamlama</th>
                        <th>Değerlendirme</th>
                        <th>Zamanında Teslim</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var perf in haftalikPerformans)
                    {
                        <tr>
                            <td>@perf.BaslangicTarihi.ToString("dd.MM") - @perf.BitisTarihi.ToString("dd.MM.yyyy")</td>
                            <td><strong>@perf.ToplamSkor.ToString("F1")</strong></td>
                            <td>@perf.GunlukGirisDuzeni.ToString("F1")%</td>
                            <td>@perf.GorevTamamlamaOrani.ToString("F1")%</td>
                            <td>@perf.SorumluDegerlendirmesi.ToString("F1")</td>
                            <td>@perf.GecTeslimOrani.ToString("F1")%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Henüz performans verisi bulunmamaktadır.
        </div>
    }

    <hr class="my-4" />
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-code-slash me-2" viewBox="0 0 16 16">
                    <path d="M10.478 1.647a.5.5 0 1 0-.956-.294l-4 13a.5.5 0 0 0 .956.294l4-13zM4.854 4.146a.5.5 0 0 1 0 .708L1.707 8l3.147 3.146a.5.5 0 0 1-.708.708l-3.5-3.5a.5.5 0 0 1 0-.708l3.5-3.5a.5.5 0 0 1 .708 0zm6.292 0a.5.5 0 0 0 0 .708L14.293 8l-3.147 3.146a.5.5 0 0 0 .708.708l3.5-3.5a.5.5 0 0 0 0-.708l-3.5-3.5a.5.5 0 0 0-.708 0z"/>
                </svg>
                Tamamlanan Projeler
            </h5>
            <small>Proje adı, GitHub linki ve kullandığınız dil(leri) ekleyebilirsiniz.</small>
        </div>
        <div class="card-body">
            <form asp-action="ProjeEkle" method="post" class="mb-4">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="projeAdi" class="form-label fw-bold">Proje Adı</label>
                        <input type="text" class="form-control" id="projeAdi" name="projeAdi" required placeholder="Örn: Stajyer Takip Sistemi" />
                    </div>
                    <div class="col-md-4">
                        <label for="githubLink" class="form-label fw-bold">GitHub Linki</label>
                        <input type="url" class="form-control" id="githubLink" name="githubLink" placeholder="https://github.com/kullanici/repo" />
                    </div>
                    <div class="col-md-4">
                        <label for="kullanilanDil" class="form-label fw-bold">Kullanılan Dil / Teknoloji</label>
                        <input type="text" class="form-control" id="kullanilanDil" name="kullanilanDil" placeholder="Örn: C#, SQL, React" />
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/></svg>
                        Proje Ekle
                    </button>
                </div>
            </form>

            @if (Model.Projeler != null && Model.Projeler.Any())
            {
                <h6 class="mb-3">Eklenen Projeler</h6>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Proje Adı</th>
                                <th>GitHub Linki</th>
                                <th>Kullanılan Dil</th>
                                <th width="90">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Projeler.OrderByDescending(x => x.OlusturmaTarihi))
                            {
                                <tr>
                                    <td class="fw-semibold">@p.ProjeAdi</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(p.GitHubLink))
                                        {
                                            <a href="@p.GitHubLink" target="_blank" rel="noopener noreferrer" class="text-decoration-none">@p.GitHubLink</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(p.KullanilanDil) ? "—" : p.KullanilanDil)</td>
                                    <td>
                                        <form asp-action="ProjeSil" method="post" class="d-inline" onsubmit="return confirm('Bu projeyi silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Henüz tamamlanan proje eklenmemiş. Yukarıdaki formu kullanarak proje ekleyebilirsiniz.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @if (haftalikPerformans.Any())
        {
            <text>
            var ctx = document.getElementById('performansChart').getContext('2d');
            var chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [
                        @foreach (var perf in haftalikPerformans)
                        {
                            <text>'@perf.BaslangicTarihi.ToString("dd.MM")',</text>
                        }
                    ],
                    datasets: [{
                        label: 'Toplam Performans Skoru',
                        data: [
                            @foreach (var perf in haftalikPerformans)
                            {
                                <text>@perf.ToplamSkor,</text>
                            }
                        ],
                        borderColor: 'rgb(75, 192, 192)',
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100
                        }
                    }
                }
            });
            </text>
        }
    </script>
}
