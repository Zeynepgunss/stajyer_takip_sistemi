@{
    ViewData["Title"] = "Giriş Yap";
}
<style>
    .login-page .btn-primary {
        background-color: #2a5298;
        border: 1px solid #2a5298;
        color: #fff;
        font-weight: 600;
    }
    .login-page .btn-primary:hover {
        background-color: #1a3a6e;
        border-color: #1a3a6e;
        color: #fff;
    }
    .login-page .text-center.mt-3 a {
        color: #2a5298;
        font-weight: 600;
    }
    .login-page .text-center.mt-3 a:hover {
        color: #1a3a6e;
    }
    .login-page .password-wrap {
        position: relative;
    }
    .login-page .password-wrap .form-control {
        padding-right: 2.5rem;
    }
    .login-page .password-wrap .btn-password-toggle {
        position: absolute;
        right: 0.25rem;
        top: 50%;
        transform: translateY(-50%);
        padding: 0.25rem 0.5rem;
        border: none;
        background: transparent;
        color: #6c757d;
        cursor: pointer;
    }
    .login-page .password-wrap .btn-password-toggle:hover {
        color: #2a5298;
    }
</style>
<div class="row justify-content-center login-page">
    <div class="col-md-4">
        <h2 class="text-center mb-4" style="color: #2a5298;">Giriş Yap</h2>
        
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <p>@TempData["Success"]</p>
            </div>
        }
        
        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" required />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Şifre</label>
                <div class="password-wrap">
                    <input type="password" class="form-control" id="password" name="password" required />
                    <button type="button" class="btn-password-toggle" id="togglePassword" aria-label="Şifreyi göster">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                        </svg>
                    </button>
                </div>
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-primary">Giriş Yap</button>
            </div>
        </form>
        
        <div class="text-center mt-3">
            <p>Hesabınız yok mu? <a asp-action="Register">Kayıt Ol</a></p>
        </div>
    </div>
</div>
@section Scripts {
<script>
    document.getElementById('togglePassword').addEventListener('click', function() {
        var input = document.getElementById('password');
        var icon = this.querySelector('svg');
        if (input.type === 'password') {
            input.type = 'text';
            icon.innerHTML = '<path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/><path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/><path d="M8 11.5a2.5 2.5 0 0 1-2.829-2.829A2.5 2.5 0 0 1 8 6.5a2.5 2.5 0 0 1 2.829 2.829A2.5 2.5 0 0 1 8 11.5zM3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709z"/>';
            this.setAttribute('aria-label', 'Şifreyi gizle');
        } else {
            input.type = 'password';
            icon.innerHTML = '<path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>';
            this.setAttribute('aria-label', 'Şifreyi göster');
        }
    });
</script>
}
