<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Stajyer Takip Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/stajyer_takip.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3 navbar-app">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Stajyer Takip Sistemi</a>
                <a class="nav-link text-dark ms-2 d-none d-sm-inline-block" asp-controller="Etkinlikler" asp-action="Index" style="font-weight: 500;">Etkinlikler</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item d-sm-none">
                            <a class="nav-link text-dark" asp-controller="Etkinlikler" asp-action="Index">Etkinlikler</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Stajyer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Stajyer" asp-action="GunlukGorevEkle">Görev Ekle</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Stajyer" asp-action="Gorevlerim">Görevlerim</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Stajyer" asp-action="Performans">Performans</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Stajyer" asp-action="Yeteneklerim">Yeteneklerim</a>
                                </li>
                            }
                            else if (User.IsInRole("BirimSorumlusu"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Etkinlikler" asp-action="Ekle">Etkinlik Ekle</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="BirimSorumlusu" asp-action="BirimYetenekHaritasi">Yetenek Haritası</a>
                                </li>
                            }
                            else if (User.IsInRole("IK"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="IK" asp-action="StajyerEkle">Stajyer Ekle</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="IK" asp-action="BirimYonetimi">Birim Yönetimi</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="IK" asp-action="GenelYetenekHaritasi">Yetenek Haritası</a>
                                </li>
                            }
                            else if (User.IsInRole("ITYoneticisi"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Etkinlikler" asp-action="Ekle">Etkinlik Ekle</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="ITYoneticisi" asp-action="KullaniciYonetimi">Kullanıcı Yönetimi</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Stajyer"))
                            {
                                var userName = User.Identity?.Name ?? "";
                                var displayName = userName.Contains("@") ? userName.Split('@')[0] : userName;
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-circle me-2" viewBox="0 0 16 16">
                                            <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                                            <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                                        </svg>
                                        <span>@displayName</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown" style="min-width: 180px; right: 0; left: auto;">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Stajyer" asp-action="Bilgilerim">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person me-2" viewBox="0 0 16 16">
                                                    <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z"/>
                                                </svg>
                                                <span>Bilgilerim</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                                <button type="submit" class="dropdown-item w-100">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-right me-2" viewBox="0 0 16 16">
                                                        <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z"/>
                                                        <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z"/>
                                                    </svg>
                                                    <span>Çıkış Yap</span>
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole("BirimSorumlusu"))
                            {
                                var userName = User.Identity?.Name ?? "";
                                var displayName = userName.Contains("@") ? userName.Split('@')[0] : userName;
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark d-flex align-items-center" href="#" id="birimSorumlusuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-circle me-2" viewBox="0 0 16 16">
                                            <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                                            <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                                        </svg>
                                        <span>@displayName</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="birimSorumlusuDropdown" style="min-width: 180px; right: 0; left: auto;">
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                                <button type="submit" class="dropdown-item w-100">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-right me-2" viewBox="0 0 16 16">
                                                        <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z"/>
                                                        <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z"/>
                                                    </svg>
                                                    <span>Çıkış Yap</span>
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole("IK"))
                            {
                                var userName = User.Identity?.Name ?? "";
                                var displayName = userName.Contains("@") ? userName.Split('@')[0] : userName;
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark d-flex align-items-center" href="#" id="ikDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-circle me-2" viewBox="0 0 16 16">
                                            <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                                            <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                                        </svg>
                                        <span>@displayName</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="ikDropdown" style="min-width: 180px; right: 0; left: auto;">
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                                <button type="submit" class="dropdown-item w-100">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-right me-2" viewBox="0 0 16 16">
                                                        <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z"/>
                                                        <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z"/>
                                                    </svg>
                                                    <span>Çıkış Yap</span>
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole("ITYoneticisi"))
                            {
                                var userName = User.Identity?.Name ?? "";
                                var displayName = userName.Contains("@") ? userName.Split('@')[0] : userName;
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark d-flex align-items-center" href="#" id="itYoneticisiDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-circle me-2" viewBox="0 0 16 16">
                                            <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                                            <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                                        </svg>
                                        <span>@displayName</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="itYoneticisiDropdown" style="min-width: 180px; right: 0; left: auto;">
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                                <button type="submit" class="dropdown-item w-100">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-right me-2" viewBox="0 0 16 16">
                                                        <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z"/>
                                                        <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z"/>
                                                    </svg>
                                                    <span>Çıkış Yap</span>
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <span class="navbar-text me-3">Merhaba, @User.Identity.Name</span>
                                </li>
                                <li class="nav-item">
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-link nav-link text-dark">Çıkış</button>
                                    </form>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Giriş</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Kayıt</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <button id="chatToggleBtn" class="chat-toggle-btn" type="button" title="Asistan">
        💬
    </button>

    <div id="chatPanel" class="chat-panel">
        <div class="chat-header">
            <div>
                <div class="chat-header-title">Belediye Asistanı</div>
                <small>Sorularınızı yanıtlamak için buradayım</small>
            </div>
            <button id="chatCloseBtn" class="chat-close-btn" type="button" aria-label="Kapat">×</button>
        </div>
        <div id="chatMessages" class="chat-body">
            <div class="chat-msg chat-msg-bot">
                Merhaba! Size nasıl yardımcı olabilirim?
            </div>
        </div>
        <div id="chatSuggestions" class="chat-suggestions">
            <button type="button" class="chat-suggestion-btn">Etkinlikler neler?</button>
            <button type="button" class="chat-suggestion-btn">Sistemde bugün neler var?</button>
            <button type="button" class="chat-suggestion-btn">Giriş nasıl yapılır?</button>
        </div>
        <div class="chat-footer">
            <input id="chatInput" class="chat-input" type="text" placeholder="Sorunuzu yazın..." maxlength="400" />
            <button id="chatSendBtn" class="chat-send-btn" type="button">Gönder</button>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center">
            &copy; 2026 - Stajyer Takip Sistemi
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chat-widget.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
